APP_DOMAIN=chat.example.com # 실제 도메인으로 변경
MYSQL_DATABASE=systemmakers # 복원할 서비스 DB
MYSQL_USER=systemmakers_app # 앱 전용 계정
MYSQL_PASSWORD= # 긴 임의 비밀번호 필수
MYSQL_ROOT_PASSWORD= # 별도의 관리자 비밀번호 필수
AUTH_RATE_LIMIT_KEY= # 32바이트 이상 난수 비밀 값 필수
PROXY_SUBNET=172.30.60.0/24 # NAS 네트워크와 충돌 여부 확인
PROXY_DYNAMIC_RANGE=172.30.60.128/25 # 프록시 고정 주소를 제외한 자동 배정 대역
CADDY_PROXY_IP=172.30.60.2 # 위 대역 안의 프록시 고정 주소
APP_IMAGE=systemmakers-php:local # 웹과 Ratchet의 공통 이미지 이름
PHP_IMAGE=php:8.3-apache-bookworm # PHP 8.3 운영 이미지 계열
MYSQL_IMAGE=mysql:8.4 # 기존 DB와 같은 8.4 계열
CADDY_IMAGE=caddy:2-alpine # Caddy 2 계열
